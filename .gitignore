# Rabbit workflow (vendored dev tool, plugin mode) — not part of the framework source

# rabbit vendored install — ignore ONLY ephemerals; track the whole .rabbit/ tool+project (Strategy D, #1086)
.rabbit/.runtime/

# Claude Code scheduler state (cron jobs) — runtime, not part of the vendored tool
.rabbit/.claude/scheduled_tasks.json
.rabbit/.claude/scheduled_tasks.lock

# auto-maintainer loop runtime state (created by /auto-maintainer:start)
.auto-maintainer/

# Python bytecode caches (regenerated whenever the plugin's modules run)
__pycache__/
*.pyc

# Claude Code project-local state at the repo root (settings.local.json, scheduler
# lock). Root-anchored (leading /) so it does NOT match the tracked vendored
# .rabbit/.claude/ tooling (Strategy D).
/.claude/
.pytest_cache/
