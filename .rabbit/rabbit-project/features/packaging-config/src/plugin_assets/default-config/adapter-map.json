{
  "CLEANUP": "run_tick:make_cleanup",
  "DONE": "run_tick:make_terminal",
  "DRAIN": "run_tick:make_drain",
  "EXIT": "run_tick:make_exit",
  "GATE": "run_tick:make_gate",
  "GUARD": "run_tick:make_guard",
  "HALTED": "run_tick:make_terminal",
  "IMPLEMENT": {
    "dispatch": [
      {
        "cardinality": {
          "per_item": "execution_plan.ordered"
        },
        "effect": "implement",
        "inputs": [
          "execution_plan",
          "work_orders"
        ],
        "output_example": {
          "artifact": {
            "kind": "pr",
            "ref": "https://github.com/owner/repo/pull/1"
          },
          "blocked_reason": null,
          "concerns": [],
          "discovered_work": [],
          "schema_version": "1.1.0",
          "status": "opened",
          "test_verdict": {
            "feature": "owner-repo-feature",
            "passed": true,
            "returncode": 0,
            "summary": "1 passed, 0 failed"
          },
          "work_order_id": "owner/repo#1-wo"
        },
        "subagent_type": "auto-maintainer:auto-maintainer-implementer",
        "task": "Enact this ACCEPTED work order: implement the change in your own git worktree and open a PR (never merge). If your item lacks the source issue body, fetch it (gh issue view) first. Follow the ## Handoff section exactly; report opened (or blocked), never planned.",
        "writes": "handoffs"
      }
    ],
    "kind": "agent",
    "manifest": {
      "emits": [
        "OK",
        "BLOCKED"
      ],
      "reads": [
        "execution_plan",
        "work_orders"
      ],
      "writes": [
        "handoffs"
      ]
    },
    "signal": {
      "rule": "blocked_if_any"
    }
  },
  "INTEGRATE": "run_tick:make_integrate",
  "PERSIST": "run_tick:make_persist",
  "PRIORITIZE": "run_tick:make_prioritize",
  "PULL": "run_tick:make_pull",
  "RECONCILE": "run_tick:make_reconcile",
  "REVIEW": {
    "dispatch": [
      {
        "cardinality": "once",
        "inputs": [
          "verdicts"
        ],
        "output_example": [
          {
            "body": "src/foo.py:12 \u2014 the change adds an unrelated config knob.",
            "dedup_key": "review:owner/repo#1:over-built",
            "filed_by": "autonomous-maintainer",
            "kind": "bug",
            "schema_version": "1.0.0",
            "severity": "high",
            "target": "project",
            "title": "PR solves a different problem than the issue asked for"
          }
        ],
        "subagent_type": "auto-maintainer:auto-maintainer-reviewer",
        "writes": "review_findings"
      }
    ],
    "kind": "agent",
    "manifest": {
      "emits": [
        "OK",
        "EMPTY"
      ],
      "reads": [
        "verdicts"
      ],
      "writes": [
        "review_findings"
      ]
    },
    "signal": {
      "rule": "always_ok"
    }
  },
  "TRIAGE": {
    "dispatch": [
      {
        "cardinality": "once",
        "inputs": [
          "work_items"
        ],
        "output_example": [
          {
            "body": "Steps to reproduce ...",
            "created_at": "2026-06-01T00:00:00Z",
            "decision": "accepted",
            "id": "owner/repo#1-wo",
            "labels": [
              "bug"
            ],
            "reason": "",
            "schema_version": "1.2.0",
            "title": "Fix the crash on empty config",
            "url": "https://github.com/owner/repo/issues/1",
            "work_item_id": "owner/repo#1"
          }
        ],
        "subagent_type": "auto-maintainer:auto-maintainer-triager",
        "writes": "work_orders"
      }
    ],
    "kind": "agent",
    "manifest": {
      "emits": [
        "OK",
        "EMPTY"
      ],
      "reads": [
        "work_items"
      ],
      "writes": [
        "work_orders"
      ]
    },
    "signal": {
      "rule": "nonempty_else_empty"
    }
  },
  "VERIFY": "run_tick:make_verify"
}
